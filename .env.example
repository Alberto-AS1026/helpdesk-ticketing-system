# --- Docker Compose (docker compose up) ---
# La URL de la base de datos la construye docker-compose.yml con DB_PASSWORD.
DB_PASSWORD=cambia_esta_clave
SECRET_KEY=genera_una_clave_con_openssl_rand_-hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8080
# Puerto del host donde se publica la web (Nginx)
WEB_PORT=8080

# --- Ejecución local sin Docker (uvicorn y pytest en el host) ---
DATABASE_URL=postgresql://helpdesk_user:cambia_esta_clave@localhost:5432/helpdesk
TEST_DATABASE_URL=postgresql://helpdesk_user:cambia_esta_clave@localhost:5432/helpdesk_test
